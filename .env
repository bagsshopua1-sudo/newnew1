# === Режим работы ===
# collect  - только сбор/мониторинг стакана (данные никуда не отправляются, ничего не торгует)
# paper    - виртуальная торговля на реальном стакане через встроенный PaperClient SDK (без риска денег)
# live     - реальная торговля реальными деньгами (нужны ключи ниже)
MODE=collect

# === Сеть ===
# mainnet или testnet
NETWORK=mainnet

# === Инструменты ===
# Именно так называются перпетуалы на Lighter (проверено на реальном запуске) -
# просто тикер, БЕЗ суффикса типа "-USDC" или "/USDC" (тот формат - для спот-рынков).
SYMBOLS=ETH,BTC

# === Длительность сбора данных (только для MODE=collect), в минутах ===
COLLECT_MINUTES=60

# === Учётные данные (нужны только для MODE=live) ===
# Индекс твоего аккаунта на Lighter (смотри в интерфейсе / через account_index)
ACCOUNT_INDEX=
# Приватный ключ API-ключа (создаётся в интерфейсе Lighter, НЕ приватный ключ кошелька!)
API_PRIVATE_KEY=
API_KEY_INDEX=0

# === Параметры сигналов (детектор стенок в стакане) ===
# Минимальный размер лимитки в USD, чтобы считаться "крупной стенкой"
WALL_MIN_USD=150000
# На сколько тиков/процентов от mid price стенка должна быть, чтобы учитываться
WALL_MAX_DISTANCE_PCT=0.3
# Порог дисбаланса объёма bid/ask (0.65 = 65/35)
IMBALANCE_THRESHOLD=0.65

# === Риск-менеджмент ===
# Депозит, которым бот может управлять (в USDC) — используется для paper и для расчёта размера позиции
ACCOUNT_EQUITY_USD=1000
# Риск на одну сделку, % от депозита
RISK_PER_TRADE_PCT=1.0
# Запасной стоп-лосс, % от цены входа - используется, ТОЛЬКО если по какой-то
# причине нет уровня-опоры (стенки сигнала). В норме стоп считается от
# структуры рынка (см. MIN/MAX_STOP_PCT ниже), а не от этого фиксированного %.
STOP_LOSS_PCT=0.6
TAKE_PROFIT_1_PCT=0.6
# Доля позиции, закрываемая на первой цели (0.5 = 50%)
TAKE_PROFIT_1_SIZE=0.5
# Трейлинг-стоп для остатка позиции после первой цели, % от максимума в прибыли
TRAILING_STOP_PCT=0.4
# Максимальное плечо
MAX_LEVERAGE=3
# Дневной лимит убытка, % от депозита — после него бот останавливается на день
DAILY_LOSS_LIMIT_PCT=3.0
# Максимум убыточных сделок подряд, после которых бот делает паузу
MAX_CONSECUTIVE_LOSSES=3
# Пауза (в минутах) после срабатывания circuit breaker
COOLDOWN_MINUTES=120

# === "Умный" стоп/тейк - от структуры сигнала, НЕ фиксированный % ===
# Стоп = |цена входа - уровень/стенка сигнала| + буфер, зажатый в диапазон
# [MIN_STOP_PCT, MAX_STOP_PCT] от цены входа. TP1 = стоп-дистанция * RR_TARGET_1
# (risk:reward), а не отдельное фиксированное число. Так расстояния до стопа и
# тейка определяет реальная структура рынка на момент сигнала, а не одно и то
# же значение для каждой сделки.
MIN_STOP_PCT=0.15
MAX_STOP_PCT=1.5
STOP_BUFFER_PCT=0.05
RR_TARGET_1=1.5
# Как часто (сек) проверять открытую позицию: срабатывание стопа/тейка по
# цене и "умный" выход по развалу структуры сделки (см. order_manager.py,
# _watch_position / _thesis_invalidated).
POSITION_CHECK_INTERVAL_SEC=1.0
# Сколько секунд после входа НЕ проверять развал структуры - без этого шум
# сразу после входа может закрыть сделку мгновенно, ещё до того как тезис
# вообще успел подтвердиться или нет.
THESIS_GRACE_PERIOD_SEC=5.0
# lighter.PaperClient не умеет держать "висящую" лимитку в очереди - IOC либо
# исполняется сразу против противоположной стороны стакана, либо отменяется
# целиком. Чтобы paper-режим вообще мог исполнять сделки, вход ставится с
# небольшим пересечением спреда (в % от цены). НЕ используется в live - там
# ордер честно висит в стакане post-only.
PAPER_CROSS_BUFFER_PCT=0.05

# === Управление лимитным ордером входа ===
# Сколько секунд ждать исполнения лимитки, прежде чем переставить/отменить
ORDER_FILL_TIMEOUT_SEC=8
# Сколько раз переставлять (chase) лимитку за сигналом, прежде чем отменить
MAX_REPRICE_ATTEMPTS=3

# === Веб-дашборд ===
# Порт статус-страницы. На Render/Railway обычно сами подставляют PORT -
# если переменная PORT задана платформой, она в приоритете над этой.
DASHBOARD_PORT=8080

# === Источник сигнала - стакан Binance Futures (публичный, без ключей) ===
# У Lighter стакан тоньше - крупные заявки Binance надёжнее отражают реальный
# интерес. Сигнал (направление/тип) строится по Binance, вход/выход всё равно
# исполняется на Lighter (0 комиссий).
USE_BINANCE_SIGNALS=true
# WebSocket partial book depth - не REST (REST банит IP за превышение веса запросов)
BINANCE_WS_DEPTH_LEVELS=20
BINANCE_WS_SPEED_MS=500
# Стакан Binance на порядки глубже Lighter - WALL_MIN_USD для него мал,
# нужен отдельный порог. Стартовое приближение, требует калибровки по факту.
BINANCE_WALL_MIN_USD=2000000
# Если цена Lighter разошлась с Binance больше чем на этот % - сигнал пропускаем
BASIS_MAX_DIVERGENCE_PCT=0.15

# === Трендовый / волатильностный фильтр ===
# Периоды быстрой/медленной EMA по mid-цене (в секундах) - определяют тренд
TREND_EMA_FAST_SEC=15
TREND_EMA_SLOW_SEC=90
# Сколько последних изменений цены учитывать для расчёта волатильности
VOL_LOOKBACK=60
# Во сколько раз текущая волатильность должна превысить базовую, чтобы считаться всплеском
VOL_SPIKE_MULT=3.0
